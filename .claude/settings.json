{
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.sentry.io)",
      "WebFetch(domain:develop.sentry.dev)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:peated.com)",
      "Bash(grep:*)",
      "Bash(jq:*)",
      "Bash(pnpx vitest:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run check:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpx tsx:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue close:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(git status:*)",
      "Bash(./Scripts/update-api.sh:*)",
      "mcp__XcodeBuildMCP__list_sims",
      "mcp__XcodeBuildMCP__boot_sim",
      "mcp__XcodeBuildMCP__open_sim",
      "mcp__XcodeBuildMCP__build_run_sim_id_proj",
      "mcp__XcodeBuildMCP__build_run_sim_name_proj",
      "mcp__XcodeBuildMCP__screenshot",
      "mcp__XcodeBuildMCP__start_sim_log_cap",
      "mcp__XcodeBuildMCP__stop_sim_log_cap",
      "mcp__XcodeBuildMCP__launch_app_sim",
      "mcp__XcodeBuildMCP__launch_app_logs_sim",
      "mcp__XcodeBuildMCP__tap",
      "mcp__XcodeBuildMCP__swipe",
      "mcp__XcodeBuildMCP__button",
      "mcp__XcodeBuildMCP__type_text",
      "mcp__XcodeBuildMCP__key_press",
      "mcp__XcodeBuildMCP__long_press",
      "mcp__XcodeBuildMCP__build_sim_name_proj",
      "mcp__XcodeBuildMCP__discover_projs",
      "mcp__XcodeBuildMCP__build_mac_proj",
      "mcp__XcodeBuildMCP__list_schems_proj",
      "mcp__XcodeBuildMCP__show_build_set_proj",
      "mcp__XcodeBuildMCP__build_sim_id_proj",
      "mcp__XcodeBuildMCP__build_dev_proj",
      "mcp__XcodeBuildMCP__swift_package_build",
      "mcp__XcodeBuildMCP__clean_proj",
      "mcp__XcodeBuildMCP__test_sim_name_proj",
      "mcp__XcodeBuildMCP__get_sim_app_path_name_proj",
      "mcp__XcodeBuildMCP__get_app_bundle_id",
      "mcp__XcodeBuildMCP__install_app_sim",
      "mcp__XcodeBuildMCP__stop_app_sim",
      "mcp__XcodeBuildMCP__stop_device_log_cap"
    ],
    "deny": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'MANDATORY: If something is unclear, you MUST ask me. ALWAYS reference our docs when they are available for a task, and make a note when they arent.'"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "includeCoAuthoredBy": false,
  "enabledMcpjsonServers": ["sentry"]
}
