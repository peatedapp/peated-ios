# Match the repository's documented style while preserving Swift 5 language mode.
--swiftversion 6.0
--language-mode 5
--indent 4
--linebreaks lf
--maxwidth 120
--trimwhitespace always

# Keep SwiftFormat from producing syntax rejected by SwiftLint's
# opening_brace and trailing_comma rules.
--disable trailingCommas,wrapMultilineStatementBraces

# Generated API types are regenerated from the OpenAPI specification. The
# executable Swift script keeps its shebang and mode outside SwiftFormat.
--exclude PeatedAPI/Sources/PeatedAPI/Generated,Scripts/recolor-png.swift
