#!/bin/bash
# Lints changed files before each commit. Install with `make install-hooks`.
# The hook only checks files; it never rewrites or re-stages them.
# CI is the real gate, so a missing toolchain warns instead of blocking.

set -euo pipefail

REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"

# shellcheck source=Scripts/lint-common.sh
. "$REPOSITORY_ROOT/Scripts/lint-common.sh"

# Native tools must match CI's pinned versions. Another version can reject
# code that CI accepts, or accept code that CI rejects.
if native_swift_lint_tools_match; then
    exec "$REPOSITORY_ROOT/Scripts/lint-changed.sh"
fi

if docker_is_running; then
    exec "$REPOSITORY_ROOT/Scripts/lint-changed-docker.sh"
fi

printf 'warning: pre-commit lint skipped; install SwiftFormat %s and SwiftLint %s, or start Docker\n' \
    "$(image_version "$SWIFTFORMAT_IMAGE")" "$(image_version "$SWIFTLINT_IMAGE")" >&2
